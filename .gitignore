# ---------------------------------------------------------------
# Secrets & credentials  (most important section - never commit these)
# ---------------------------------------------------------------
.env
.env.*
*.env
secrets.*
credentials.*
*.pem
*.key
*.p12
*.pfx
id_rsa*
.Renviron

# ---------------------------------------------------------------
# Python
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-log.txt

# Virtual environments
.venv/
venv/
env/
ENV/
.conda/
conda-env/

# Testing / linting caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# ---------------------------------------------------------------
# Jupyter
# ---------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py

# ---------------------------------------------------------------
# R
# ---------------------------------------------------------------
.Rhistory
.Rapp.history
.RData
.Ruserdata
*.Rproj.user/
.Rproj.user/

# ---------------------------------------------------------------
# Data science scratch output
# (Tracked data files in this repo are intentional and committed;
#  these patterns only catch regenerated/temporary artifacts.)
# ---------------------------------------------------------------
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
checkpoints/
mlruns/
wandb/
.ipynb_convert/

